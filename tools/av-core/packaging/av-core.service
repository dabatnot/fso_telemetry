[Unit]
Description=FSO SimPit AV CORE
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=fsotelemetry
Group=fsotelemetry
WorkingDirectory=/opt/fsotelemetry/av-core
StateDirectory=fsotelemetry
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/fsotelemetry/av-core/backend
Environment=AV_CORE_FSTL_CLIENT_DIR=/opt/fsotelemetry/av-core/fstl-client
ExecStart=/opt/fsotelemetry/av-core/.venv/bin/python -m av_core --host 0.0.0.0 --config /var/lib/fsotelemetry/av-core.json --frontend-dir /opt/fsotelemetry/av-core/frontend
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
